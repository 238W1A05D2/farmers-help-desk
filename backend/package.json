{
  "name": "soil-salinity-backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Soil Salinity Monitoring",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "setup-db": "ts-node scripts/setupDb.ts",
    "import-csv": "ts-node scripts/importCsv.ts",
    "import-godavari": "ts-node scripts/importGodavariCsv.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
