# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soil_salinity_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── CSV Paths (relative to /backend directory) ───────────────────────────────
# Bapatla dataset  (years 2015–2030, columns: system:index, 0_EC_2015 … .geo)
CSV_FILE_PATH=../data/EC_SpatialTemporal_Bapatla_Predicted_2026_2030.csv

# Godavari dataset (years 2010–2035, columns: point_id, latitude, longitude, SSI 2010 … SSI 2035)
GODAVARI_CSV_PATH=../data/Godavari_SSI_Wide_Format_2010_2035.csv
